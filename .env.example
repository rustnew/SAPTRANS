DATABASE_URL=postgres://saptrans:change-me@localhost:5432/saptrans
LISTEN_ADDR=0.0.0.0:3000
RUST_LOG=info
# Générer avec: openssl rand -hex 64
# SAPTRANS_SESSION_KEY_HEX=<résultat de openssl rand -hex 64>
# Définir false uniquement pour les essais locaux sans HTTPS.
# SAPTRANS_COOKIE_SECURE=false
# SMTP_HOST=smtp.example.com
# SMTP_FROM=site@example.com
# CONTACT_RECIPIENT=contact@example.com
